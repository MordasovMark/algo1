{
  "meta": {
    "notes": "LeetCode-style judge specs, keyed by LeetCode number. Tests are our own, not LeetCode's. build.py runs data/judge/solutions/<n>.py through every test and fails the build if a reference solution does not pass. Fields: sig = method line as on LeetCode; types/ret = ListNode or TreeNode where the value is given as a list; tests[].example = shown in the statement and used by Run; tests[].gen / expectGen = Python expressions for big inputs, with label as the text shown instead of the input; tests[].extra = efficiency challenge outside LeetCode's constraints, does not affect Accepted. limitMs = time limit per test in the browser.",
    "status": "pilot"
  },
  "problems": {
    "509": {
      "method": "fib",
      "sig": "def fib(self, n: int) -> int:",
      "params": ["n"],
      "limitMs": 2000,
      "constraints": ["0 <= n <= 30"],
      "tests": [
        { "args": [2], "expected": 1, "example": true },
        { "args": [3], "expected": 2, "example": true },
        { "args": [4], "expected": 3, "example": true },
        { "args": [0], "expected": 0 },
        { "args": [1], "expected": 1 },
        { "args": [10], "expected": 55 },
        { "args": [20], "expected": 6765 },
        { "args": [25], "expected": 75025 },
        { "args": [30], "expected": 832040 },
        { "args": [40], "expected": 102334155, "extra": true, "label": { "he": "n = 40 (מעבר לאילוצים של LeetCode)", "en": "n = 40 (beyond LeetCode's constraints)" } }
      ]
    },
    "206": {
      "method": "reverseList",
      "sig": "def reverseList(self, head: Optional[ListNode]) -> Optional[ListNode]:",
      "params": ["head"],
      "types": ["ListNode"],
      "ret": "ListNode",
      "limitMs": 2000,
      "constraints": ["0 <= number of nodes <= 5000", "-5000 <= Node.val <= 5000"],
      "tests": [
        { "args": [[1, 2, 3, 4, 5]], "expected": [5, 4, 3, 2, 1], "example": true },
        { "args": [[1, 2]], "expected": [2, 1], "example": true },
        { "args": [[]], "expected": [], "example": true },
        { "args": [[7]], "expected": [7] },
        { "args": [[1, 1, 2]], "expected": [2, 1, 1] },
        { "args": [[-5000, 0, 5000]], "expected": [5000, 0, -5000] },
        { "gen": "[list(range(5000))]", "expectGen": "list(range(4999, -1, -1))", "label": { "he": "רשימה של 5000 צמתים", "en": "a list of 5000 nodes" } }
      ]
    },
    "104": {
      "method": "maxDepth",
      "sig": "def maxDepth(self, root: Optional[TreeNode]) -> int:",
      "params": ["root"],
      "types": ["TreeNode"],
      "limitMs": 2000,
      "constraints": ["0 <= number of nodes <= 10^4", "-100 <= Node.val <= 100"],
      "tests": [
        { "args": [[3, 9, 20, null, null, 15, 7]], "expected": 3, "example": true },
        { "args": [[1, null, 2]], "expected": 2, "example": true },
        { "args": [[]], "expected": 0 },
        { "args": [[1]], "expected": 1 },
        { "args": [[1, 2, 3, 4, null, null, 5, 6]], "expected": 4 },
        { "args": [[1, 2, null, 3, null, 4, null, 5]], "expected": 5 },
        { "gen": "[[i % 100 for i in range(10000)]]", "expected": 14, "label": { "he": "עץ מלא עם 10,000 צמתים", "en": "a complete tree with 10,000 nodes" } },
        { "gen": "[[0] + [x for i in range(1, 3000) for x in (i % 100, None)]]", "expected": 3000, "label": { "he": "שרשרת של 3000 צמתים (עץ עמוק)", "en": "a chain of 3000 nodes (a deep tree)" } }
      ]
    }
  }
}
